# ---- Browser (static site): put these in assets/js/supabase-config.js (NOT secret) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- PHP (server side only - SECRET, never commit, never ship to the browser) ----
SUPABASE_DB_HOST=aws-0-YOUR-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
SUPABASE_DB_PASS=YOUR-DATABASE-PASSWORD
