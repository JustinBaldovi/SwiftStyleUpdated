/* CHRISTMAS SNOW EFFECT */

#december:checked ~ .website .hero::after {

    content: "❄  ❅  ❄  ❅  ❄  ❅";

    position: absolute;

    right: 30px;

    top: 20px;

    color: white;

    opacity: 0.6;

    letter-spacing: 15px;

    animation: snowfall 4s linear infinite;

}


@keyframes snowfall {

    0% {

        transform: translateY(-20px);

        opacity: 0;

    }

    50% {

        opacity: 0.8;

    }

    100% {

        transform: translateY(180px);

        opacity: 0;

    }

}


/* =========================================
   RESPONSIVE DESIGN
========================================= */

@media (max-width: 800px) {

    .website {

        width: 96%;

        margin: 15px auto;

        border-radius: 20px;

    }


    .hero {

        padding: 35px 25px;

    }


    .decorations {

        right: 25px;

        font-size: 3rem;

    }


    .month-content {

        padding: 30px 20px;

    }


    .month-introduction {

        flex-direction: column;

    }


    .calendar-and-planner {

        grid-template-columns: 1fr;

    }


    .simple-month {

        padding: 35px 20px;

    }


    .simple-month h2 {

        font-size: 3rem;

    }

}


@media (max-width: 500px) {

    .calendar-card,
    .planner-card {

        padding: 20px 12px;

    }


    .dates span {

        min-height: 38px;

        font-size: 0.75rem;

    }


    .weekdays span {

        font-size: 0.55rem;

    }


    .month-navigation label {

        min-width: 55px;

        font-size: 0.65rem;

    }

}