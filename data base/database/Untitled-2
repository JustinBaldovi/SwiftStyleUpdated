/* =========================================
   GOOGLE FONT
========================================= */

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');


/* =========================================
   RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


/* =========================================
   COLOR VARIABLES
   DEFAULT: NAVY + GREEN
========================================= */

:root {

    --navy: #102a43;
    --navy-light: #243b53;

    --green: #3d7a5a;
    --green-light: #e8f2ec;

    --background: #f7f8f6;

    --white: #ffffff;

    --text: #1f2933;

    --soft-text: #6b7280;

    --accent: #3d7a5a;

}


/* =========================================
   BODY
========================================= */

body {

    font-family: "DM Sans", sans-serif;

    background:
        linear-gradient(
            135deg,
            #eef4f1,
            #f8faf9
        );

    color: var(--text);

    min-height: 100vh;

}


/* HIDE RADIO BUTTONS */

body > input[type="radio"] {

    position: absolute;

    opacity: 0;

}


/* =========================================
   MAIN WEBSITE
========================================= */

.website {

    width: min(1100px, 92%);

    margin: 40px auto;

    background: rgba(255, 255, 255, 0.75);

    border: 1px solid rgba(16, 42, 67, 0.08);

    border-radius: 30px;

    overflow: hidden;

    box-shadow:
        0 20px 60px rgba(16, 42, 67, 0.08);

}


/* =========================================
   HERO SECTION
========================================= */

.hero {

    min-height: 300px;

    padding: 50px;

    background:
        linear-gradient(
            135deg,
            var(--navy),
            #183f5f
        );

    color: white;

    position: relative;

    overflow: hidden;

}


.hero::before {

    content: "";

    position: absolute;

    width: 300px;

    height: 300px;

    border-radius: 50%;

    border: 1px solid rgba(255,255,255,0.1);

    right: -100px;

    top: -100px;

}


.logo {

    font-size: 0.8rem;

    letter-spacing: 3px;

    font-weight: 700;

    margin-bottom: 45px;

}


.logo span {

    color: #72b38c;

}


.hero-text {

    max-width: 650px;

}


.small-title {

    color: #9ed1b1;

    font-size: 0.75rem;

    letter-spacing: 3px;

    margin-bottom: 12px;

}


.hero h1 {

    font-family: "Playfair Display", serif;

    font-size: clamp(2.5rem, 6vw, 4.8rem);

    line-height: 1;

    margin-bottom: 20px;

}


.hero-text > p:last-child {

    color: rgba(255,255,255,0.75);

    max-width: 550px;

    line-height: 1.7;

}


/* =========================================
   DECORATIONS
========================================= */

.decorations {

    position: absolute;

    right: 60px;

    bottom: 40px;

    font-size: 4rem;

    animation: float 4s ease-in-out infinite;

}


.decorations span {

    display: none;

}


@keyframes float {

    0%, 100% {

        transform: translateY(0);

    }

    50% {

        transform: translateY(-12px);

    }

}


/* =========================================
   MONTH NAVIGATION
========================================= */

.month-navigation {

    display: flex;

    gap: 8px;

    padding: 20px;

    overflow-x: auto;

    background: white;

    border-bottom:
        1px solid rgba(16,42,67,0.08);

}


.month-navigation label {

    min-width: 62px;

    padding: 10px 12px;

    text-align: center;

    font-size: 0.72rem;

    letter-spacing: 1px;

    font-weight: 700;

    color: var(--soft-text);

    border-radius: 12px;

    cursor: pointer;

    transition: 0.25s ease;

}


.month-navigation label:hover {

    background: var(--green-light);

    color: var(--green);

    transform: translateY(-2px);

}


/* =========================================
   MONTH CONTENT
========================================= */

.month-content {

    display: none;

    padding: 50px;

}


.month-introduction {

    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    gap: 30px;

    margin-bottom: 40px;

}


.month-number {

    color: var(--accent);

    letter-spacing: 3px;

    font-size: 0.75rem;

    font-weight: 700;

    margin-bottom: 10px;

}


.month-introduction h2 {

    font-family: "Playfair Display", serif;

    font-size: clamp(2.5rem, 5vw, 4rem);

    color: var(--navy);

    margin-bottom: 12px;

}


.month-introduction p {

    color: var(--soft-text);

    line-height: 1.7;

    max-width: 600px;

}


.theme-badge {

    background: var(--green-light);

    color: var(--accent);

    padding: 12px 18px;

    border-radius: 50px;

    font-size: 0.75rem;

    letter-spacing: 1px;

    font-weight: 700;

    white-space: nowrap;

}


/* =========================================
   CALENDAR + PLANNER
========================================= */

.calendar-and-planner {

    display: grid;

    grid-template-columns: 1.2fr 0.8fr;

    gap: 25px;

}


.calendar-card,
.planner-card {

    background: white;

    border-radius: 24px;

    padding: 30px;

    border:
        1px solid rgba(16,42,67,0.08);

}


.calendar-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 25px;

}


.calendar-header h3 {

    font-family: "Playfair Display", serif;

    font-size: 1.5rem;

    color: var(--navy);

}


.calendar-header span {

    font-size: 1.8rem;

}


/* =========================================
   CALENDAR DAYS
========================================= */

.weekdays,
.dates {

    display: grid;

    grid-template-columns: repeat(7, 1fr);

    text-align: center;

    gap: 7px;

}


.weekdays {

    margin-bottom: 15px;

}


.weekdays span {

    font-size: 0.65rem;

    font-weight: 700;

    color: var(--soft-text);

}


.dates span {

    min-height: 43px;

    display: flex;

    justify-content: center;

    align-items: center;

    border-radius: 12px;

    font-size: 0.85rem;

    transition: 0.2s;

}


.dates span:not(:empty):hover {

    background: var(--green-light);

    color: var(--accent);

    cursor: pointer;

    transform: scale(1.08);

}


.special-day {

    background: var(--accent) !important;

    color: white !important;

    font-weight: 700;

}


/* =========================================
   PLANNER
========================================= */

.planner-card h3 {

    color: var(--navy);

    margin-bottom: 20px;

}


.planner-card input,
.planner-card textarea,
.simple-month textarea {

    width: 100%;

    border: 1px solid rgba(16,42,67,0.15);

    border-radius: 12px;

    padding: 14px;

    font-family: inherit;

    outline: none;

    margin-bottom: 15px;

    transition: 0.25s;

}


.planner-card textarea,
.simple-month textarea {

    min-height: 150px;

    resize: vertical;

}


.planner-card input:focus,
.planner-card textarea:focus,
.simple-month textarea:focus {

    border-color: var(--accent);

    box-shadow:
        0 0 0 4px
        rgba(61,122,90,0.1);

}


.checklist {

    display: grid;

    gap: 10px;

}


.checklist label {

    display: flex;

    align-items: center;

    gap: 10px;

    cursor: pointer;

    font-size: 0.85rem;

}


.checklist input {

    accent-color: var(--accent);

}


/* =========================================
   SIMPLE MONTHS
========================================= */

.simple-month {

    background: white;

    padding: 60px;

    border-radius: 28px;

    text-align: center;

    border:
        1px solid rgba(16,42,67,0.08);

}


.simple-month > p {

    color: var(--accent);

    letter-spacing: 4px;

    font-size: 0.75rem;

    font-weight: bold;

}


.simple-month h2 {

    font-family: "Playfair Display", serif;

    font-size: 4rem;

    color: var(--navy);

    margin: 10px 0;

}


.simple-month h3 {

    color: var(--soft-text);

    font-weight: 400;

    margin-bottom: 30px;

}


/* =========================================
   MUSIC SECTION
========================================= */

.music-section {

    text-align: center;

    padding: 40px;

    background: var(--green-light);

}


.music-section h3 {

    color: var(--navy);

    margin-bottom: 10px;

}


.music-section p {

    font-size: 0.85rem;

    color: var(--soft-text);

    margin-bottom: 15px;

}


/* =========================================
   FOOTER
========================================= */

footer {

    padding: 25px;

    text-align: center;

    background: var(--navy);

    color: rgba(255,255,255,0.65);

    font-size: 0.7rem;

    letter-spacing: 2px;

}


/* =========================================
   JANUARY ACTIVE
========================================= */

